---
interface Props {
  title: string
  period: string
  problem: string
  solution: string
  result: string[]
  learned?: string
  stack: string
}

const { title, period, problem, solution, result, learned, stack } = Astro.props
---

<article class="project-card">
  <h3>{title}</h3>
  <p class="period"><em>{period}</em></p>

  <h4>Problem</h4>
  <p>{problem}</p>

  <h4>Solution</h4>
  <p>{solution}</p>

  <h4>Result</h4>
  <ul>
    {result.map((r) => <li>{r}</li>)}
  </ul>

  {
    learned && (
      <>
        <h4>What I Learned</h4>
        <blockquote>{learned}</blockquote>
      </>
    )
  }

  <p class="stack"><strong>Stack:</strong> {stack}</p>
</article>

<style>
  .project-card {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }
  .project-card:last-child {
    border-bottom: none;
  }
  .period {
    color: var(--sl-color-gray-3);
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
  }
  h3 {
    margin-bottom: 0.25rem;
  }
  h4 {
    margin-top: 1.25rem;
    margin-bottom: 0.25rem;
    color: var(--sl-color-accent);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stack {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }
  blockquote {
    border-left: 3px solid var(--sl-color-accent);
    padding-left: 1rem;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }
</style>